{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Academic student profile settings (non-PII)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the student",
          "minLength": 1,
          "maxLength": 150
        },
        "university": {
          "type": "string",
          "description": "University name",
          "minLength": 1,
          "maxLength": 200
        },
        "faculty": {
          "type": "string",
          "description": "Faculty or department name",
          "minLength": 1,
          "maxLength": 200
        },
        "group": {
          "type": "string",
          "description": "Academic group code",
          "minLength": 1,
          "maxLength": 50
        },
        "semester": {
          "type": "integer",
          "description": "Current study semester (1 to 12)"
        },
        "degree": {
          "type": "string",
          "description": "Academic degree level",
          "enum": ["Bachelor", "Master", "Specialist"]
        },
        "theme": {
          "type": "string",
          "description": "UI theme preference",
          "enum": ["dark", "light"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": [
        "uid",
        "name",
        "university",
        "faculty",
        "group",
        "semester",
        "degree",
        "theme",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for the user (email)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "LectureDoc": {
      "title": "LectureDoc",
      "description": "Recorded or imported university lecture notes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique lecture identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the student who owns the lecture",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Lecture title",
          "minLength": 1,
          "maxLength": 300
        },
        "subject": {
          "type": "string",
          "description": "Academic subject name",
          "minLength": 1,
          "maxLength": 200
        },
        "lecturer": {
          "type": "string",
          "description": "Lecturer name",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Human-readable lecture date",
          "minLength": 1,
          "maxLength": 100
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Duration of the lecture in seconds"
        },
        "audioFileName": {
          "type": "string",
          "description": "Name of associated audio file or empty string",
          "maxLength": 255
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 10 subject/topic tags"
        },
        "noiseLevel": {
          "type": "string",
          "description": "Acoustic noise classification",
          "enum": ["quiet", "moderate", "noisy", "echo"]
        },
        "modelUsed": {
          "type": "string",
          "description": "ASR/LLM model descriptor",
          "minLength": 1,
          "maxLength": 200
        },
        "quantization": {
          "type": "string",
          "description": "Quantization format",
          "minLength": 1,
          "maxLength": 100
        },
        "summaryMarkdown": {
          "type": "string",
          "description": "Structured lecture notes in Markdown and LaTeX",
          "minLength": 1,
          "maxLength": 100000
        },
        "transcriptText": {
          "type": "string",
          "description": "Full text transcript of the lecture",
          "minLength": 1,
          "maxLength": 100000
        },
        "formulasLatex": {
          "type": "array",
          "description": "Bounded list of up to 20 extracted LaTeX formulas"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "subject",
        "lecturer",
        "date",
        "durationSeconds",
        "audioFileName",
        "tags",
        "noiseLevel",
        "modelUsed",
        "quantization",
        "summaryMarkdown",
        "transcriptText",
        "formulasLatex",
        "createdAt",
        "updatedAt"
      ]
    },
    "TaskDoc": {
      "title": "TaskDoc",
      "description": "Action item or deadline extracted from a lecture",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lectureId": {
          "type": "string",
          "description": "Parent lecture ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "task": {
          "type": "string",
          "description": "Task description",
          "minLength": 1,
          "maxLength": 1000
        },
        "deadline": {
          "type": "string",
          "description": "Human-readable deadline label",
          "minLength": 1,
          "maxLength": 200
        },
        "dateISO": {
          "type": "string",
          "description": "ISO date string for the deadline",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "description": "Category of academic task",
          "enum": ["homework", "exam", "reading", "project", "colloquium"]
        },
        "completed": {
          "type": "boolean",
          "description": "Completion state of the task"
        },
        "priority": {
          "type": "string",
          "description": "Priority level",
          "enum": ["high", "medium", "low"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "lectureId",
        "ownerId",
        "task",
        "deadline",
        "dateISO",
        "type",
        "completed",
        "priority",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student academic profile document owned by userId"
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII storage (email) owned by userId"
    },
    "/users/{userId}/lectures/{lectureId}": {
      "schema": { "$ref": "#/entities/LectureDoc" },
      "description": "Lectures recorded or imported by userId"
    },
    "/users/{userId}/lectures/{lectureId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskDoc" },
      "description": "Deadlines and action items belonging to a specific lecture"
    }
  }
}
